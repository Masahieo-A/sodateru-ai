{
  "schemaVersion": "1.0.0",
  "curriculumId": "high-school-grammar-sample",
  "title": "育てるAI 英文法サンプル",
  "language": "ja-en",
  "sources": [{ "id": "original-sample", "title": "プロジェクト作成のオリジナル例題", "kind": "original", "publisher": "育てるAI", "edition": "sample-1", "page": "original" }],
  "rubricCriteria": [{ "id": "criterion.correctness", "label": "正確性", "description": "正答と根拠が一致する" }],
  "units": [
    { "id": "relative-adverb", "title": "関係副詞", "description": "where / when / why / how を使った関係節", "sourceRefs": ["original-sample"], "knowledge": [{ "id": "relative-adverb.place", "label": "場所の where", "description": "場所を表す先行詞を後ろから説明する" }, { "id": "relative-adverb.time", "label": "時の when", "description": "時を表す先行詞を後ろから説明する" }, { "id": "relative-adverb.reason", "label": "理由の why", "description": "reason を先行詞にする" }], "questionBank": [{ "id": "relative-adverb.q1", "type": "multiple-choice", "prompt": "This is the city ___ I was born.", "choices": [{ "label": "A", "text": "where" }, { "label": "B", "text": "when" }, { "label": "C", "text": "which" }, { "label": "D", "text": "who" }], "answer": "A", "knowledgeIds": ["relative-adverb.place"], "difficulty": "intro" }, { "id": "relative-adverb.q2", "type": "multiple-choice", "prompt": "I remember the day ___ we first met.", "choices": [{ "label": "A", "text": "where" }, { "label": "B", "text": "when" }, { "label": "C", "text": "why" }, { "label": "D", "text": "how" }], "answer": "B", "knowledgeIds": ["relative-adverb.time"], "difficulty": "intro" }, { "id": "relative-adverb.q3", "type": "multiple-choice", "prompt": "That is the reason ___ he left early.", "choices": [{ "label": "A", "text": "where" }, { "label": "B", "text": "when" }, { "label": "C", "text": "why" }, { "label": "D", "text": "which" }], "answer": "C", "knowledgeIds": ["relative-adverb.reason"], "difficulty": "standard" }], "sampling": { "practiceCount": 2, "testCount": 1, "minKnowledgeCoverage": 3, "avoidRepeatingQuestionIds": true } },
    { "id": "relative-pronoun", "title": "関係代名詞", "description": "who / which / that / whose の関係節", "sourceRefs": ["original-sample"], "knowledge": [{ "id": "relative-pronoun.person", "label": "人の who", "description": "人を表す先行詞を説明する" }, { "id": "relative-pronoun.thing", "label": "物の which", "description": "物を表す先行詞を説明する" }], "questionBank": [{ "id": "relative-pronoun.q1", "type": "multiple-choice", "prompt": "The girl ___ won the prize is my sister.", "choices": [{ "label": "A", "text": "who" }, { "label": "B", "text": "which" }, { "label": "C", "text": "where" }, { "label": "D", "text": "when" }], "answer": "A", "knowledgeIds": ["relative-pronoun.person"], "difficulty": "intro" }, { "id": "relative-pronoun.q2", "type": "multiple-choice", "prompt": "The book ___ I read was interesting.", "choices": [{ "label": "A", "text": "who" }, { "label": "B", "text": "which" }, { "label": "C", "text": "when" }, { "label": "D", "text": "where" }], "answer": "B", "knowledgeIds": ["relative-pronoun.thing"], "difficulty": "standard" }, { "id": "relative-pronoun.q3", "type": "multiple-choice", "prompt": "I know a boy ___ father is a doctor.", "choices": [{ "label": "A", "text": "whose" }, { "label": "B", "text": "who" }, { "label": "C", "text": "which" }, { "label": "D", "text": "where" }], "answer": "A", "knowledgeIds": ["relative-pronoun.person"], "difficulty": "challenge" }], "sampling": { "practiceCount": 2, "testCount": 1, "minKnowledgeCoverage": 2, "avoidRepeatingQuestionIds": true } },
    { "id": "passive-voice", "title": "受動態", "description": "be動詞 + 過去分詞の構造", "sourceRefs": ["original-sample"], "knowledge": [{ "id": "passive.present", "label": "現在形", "description": "am / is / are + 過去分詞" }, { "id": "passive.past", "label": "過去形", "description": "was / were + 過去分詞" }, { "id": "passive.perfect", "label": "現在完了", "description": "has / have been + 過去分詞" }], "questionBank": [{ "id": "passive.q1", "type": "multiple-choice", "prompt": "English ___ spoken all over the world.", "choices": [{ "label": "A", "text": "is" }, { "label": "B", "text": "was" }, { "label": "C", "text": "are" }, { "label": "D", "text": "been" }], "answer": "A", "knowledgeIds": ["passive.present"], "difficulty": "intro" }, { "id": "passive.q2", "type": "multiple-choice", "prompt": "This letter ___ written by Tom yesterday.", "choices": [{ "label": "A", "text": "is" }, { "label": "B", "text": "was" }, { "label": "C", "text": "were" }, { "label": "D", "text": "be" }], "answer": "B", "knowledgeIds": ["passive.past"], "difficulty": "standard" }, { "id": "passive.q3", "type": "multiple-choice", "prompt": "The cake has ___ eaten by the children.", "choices": [{ "label": "A", "text": "be" }, { "label": "B", "text": "was" }, { "label": "C", "text": "been" }, { "label": "D", "text": "being" }], "answer": "C", "knowledgeIds": ["passive.perfect"], "difficulty": "challenge" }], "sampling": { "practiceCount": 2, "testCount": 1, "minKnowledgeCoverage": 3, "avoidRepeatingQuestionIds": true } },
    { "id": "subjunctive", "title": "仮定法", "description": "if節を使った仮定・非現実の表現", "sourceRefs": ["original-sample"], "knowledge": [{ "id": "subjunctive.present-unreal", "label": "現在の反事実", "description": "If + 過去形、主節 would/could + 原形" }, { "id": "subjunctive.past-unreal", "label": "過去の反事実", "description": "If + had + 過去分詞、主節 would have + 過去分詞" }, { "id": "subjunctive.were", "label": "wereの特別用法", "description": "仮定法過去の be は主語にかかわらず were" }], "questionBank": [{ "id": "subjunctive.q1", "type": "multiple-choice", "prompt": "If I ___ a bird, I could fly.", "choices": [{ "label": "A", "text": "am" }, { "label": "B", "text": "was" }, { "label": "C", "text": "were" }, { "label": "D", "text": "be" }], "answer": "C", "knowledgeIds": ["subjunctive.present-unreal", "subjunctive.were"], "difficulty": "intro" }, { "id": "subjunctive.q2", "type": "multiple-choice", "prompt": "If she had studied harder, she ___ have passed.", "choices": [{ "label": "A", "text": "will" }, { "label": "B", "text": "would" }, { "label": "C", "text": "can" }, { "label": "D", "text": "must" }], "answer": "B", "knowledgeIds": ["subjunctive.past-unreal"], "difficulty": "standard" }, { "id": "subjunctive.q3", "type": "multiple-choice", "prompt": "I wish I ___ taller.", "choices": [{ "label": "A", "text": "am" }, { "label": "B", "text": "was" }, { "label": "C", "text": "were" }, { "label": "D", "text": "will be" }], "answer": "C", "knowledgeIds": ["subjunctive.present-unreal", "subjunctive.were"], "difficulty": "standard" }], "sampling": { "practiceCount": 2, "testCount": 1, "minKnowledgeCoverage": 2, "avoidRepeatingQuestionIds": true } }
  ]
}
