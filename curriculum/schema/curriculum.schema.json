{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sodateru-ai.local/schemas/curriculum-1.0.0.json",
  "title": "Sodateru AI curriculum",
  "type": "object",
  "required": ["schemaVersion", "curriculumId", "title", "language", "sources", "rubricCriteria", "units"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "curriculumId": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "language": { "enum": ["ja", "en", "ja-en"] },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "rubricCriteria": { "type": "array", "items": { "type": "object", "required": ["id", "label", "description"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "description": { "type": "string" } } } },
    "units": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unit" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "source": {
      "type": "object", "required": ["id", "title", "kind"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "kind": { "enum": ["textbook", "teacher-note", "open-resource", "original"] }, "locator": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "checkedAt": { "type": "string", "format": "date" }, "publisher": { "type": "string" }, "edition": { "type": "string" }, "page": { "type": "string" } }
    },
    "knowledge": {
      "type": "object", "required": ["id", "label", "description"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "description": { "type": "string" }, "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } } }
    },
    "question": {
      "type": "object", "required": ["id", "type", "prompt", "choices", "answer", "knowledgeIds"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "multiple-choice" }, "prompt": { "type": "string", "minLength": 1 }, "choices": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "object", "required": ["label", "text"], "properties": { "label": { "type": "string" }, "text": { "type": "string" } } } }, "answer": { "type": "string" }, "explanation": { "type": "string" }, "hint": { "type": "string" }, "knowledgeIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "difficulty": { "enum": ["intro", "standard", "challenge"] }, "eligibility": { "enum": ["practice", "assessment", "both"] }, "misconceptionRationale": { "type": "string" }, "rubricCriteriaIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "answerAmbiguity": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["unique", "ambiguous"] }, "note": { "type": "string" } } } }
    },
    "unit": {
      "type": "object", "required": ["id", "title", "description", "knowledge", "questionBank", "sampling"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "description": { "type": "string" }, "knowledge": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/knowledge" } }, "prerequisiteKnowledge": { "type": "array", "items": { "$ref": "#/$defs/knowledge" } }, "questionBank": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }, "sampling": { "type": "object", "required": ["practiceCount", "testCount"], "properties": { "practiceCount": { "type": "integer", "minimum": 0 }, "testCount": { "type": "integer", "minimum": 0 }, "minKnowledgeCoverage": { "type": "integer", "minimum": 0 }, "avoidRepeatingQuestionIds": { "type": "boolean" }, "perKnowledgeMinimums": { "type": "object", "additionalProperties": { "type": "object", "required": ["practice", "assessment"], "properties": { "practice": { "type": "integer", "minimum": 0 }, "assessment": { "type": "integer", "minimum": 0 } } } }, "deterministicSeedStrategy": { "enum": ["session-unit-v1", "fixed", "none"] } } }, "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } } }
    }
  }
}
